 (3, 'Алексей Иванов', 'Казань, ул. Гагарина, 15', '+7-999-3333333');

 -- Вставляем 3 жокея
 INSERT INTO jockeys (id, name, address, age, rating) VALUES
 (1, 'Алексей Смирнов', 'Москва, ул. Тверская, 20', 28, 8.5),
