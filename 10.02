Задача про лошадей
 -- 1. Владельцы (имя, адрес, телефон)
 CREATE TABLE owners (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    address VARCHAR(200),
    phone VARCHAR(20)
 );

 -- 2. Жокеи (имя, адрес, возраст, рейтинг)
 CREATE TABLE jockeys (
    id INT PRIMARY KEY,
    name VARCHAR(100),
    address VARCHAR(200),
    age INT,
    rating DECIMAL(3,1)
 );

 -- 3. Лошади (кличка, пол, возраст, владелец)
 CREATE TABLE horses (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    gender VARCHAR(10),
    age INT,
    owner_id INT,
    FOREIGN KEY (owner_id) REFERENCES owners(id)
 );

 -- 4. Соревнования (дата, время, ипподром, название)
 CREATE TABLE competitions (
    id INT PRIMARY KEY,
    date DATE,
    time TIME,
    racecourse VARCHAR(100),
    title VARCHAR(200)
 );

 -- 5. Заезды (номер заезда, соревнование)
 CREATE TABLE races (
    id INT PRIMARY KEY,
    competition_id INT,
    race_number INT,
    FOREIGN KEY (competition_id) REFERENCES competitions(id)
 );

 -- 6. Результаты (заезд, лошадь, жокей, место, время)
 CREATE TABLE results (
    id INT PRIMARY KEY,
    race_id INT,
    horse_id INT,
    jockey_id INT,
    place INT,
    finish_time TIME,
    FOREIGN KEY (race_id) REFERENCES races(id),
    FOREIGN KEY (horse_id) REFERENCES horses(id),
    FOREIGN KEY (jockey_id) REFERENCES jockeys(id)
 );

 -- Вставляем 3 владельца
 INSERT INTO owners (id, name, address, phone) VALUES 
 (1, 'Иван Петров', 'Москва, ул. Ленина, 10', '+7-999-1111111'),
