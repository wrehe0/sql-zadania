 (3, 'Екатерина Волкова', 'Санкт-Петербург, ул. Невский, 25', 31, 8.8);
 
 -- Вставляем 3 лошади
 INSERT INTO horses (id, name, gender, age, owner_id) VALUES
 (1, 'Буран', 'жеребец', 5, 1),
 (2, 'Звезда', 'кобыла', 4, 2),
 (3, 'Ветер', 'мерин', 6, 3);
 
 -- Вставляем 3 соревнования
 INSERT INTO competitions (id, date, time, racecourse, title) VALUES
 (1, '2024-06-15', '14:00:00', 'Московский ипподром', 'Кубок весны'),
 (2, '2024-06-22', '15:30:00', 'Московский ипподром', 'Большой приз'),
 (3, '2024-07-01', '13:00:00', 'Петербургский ипподром', NULL);
 
 -- Вставляем 3 заезда
 INSERT INTO races (id, competition_id, race_number) VALUES
 (1, 1, 1),
 (2, 1, 2),
 (3, 2, 1);
 
 -- Вставляем 3 результата
 INSERT INTO results (id, race_id, horse_id, jockey_id, place, finish_time) VALUES
 (1, 1, 1, 1, 1, '01:23:45'),
 (2, 1, 2, 2, 2, '01:24:10'),
 (3, 2, 3, 3, 1, '02:15:30');
 
 -- Выводим всю информацию о скачках как в задании
 SELECT 
    c.date AS 'Дата',
    c.time AS 'Время',
    c.racecourse AS 'Ипподром',
    c.title AS 'Название состязания',
    r.race_number AS 'Номер заезда',
    h.name AS 'Кличка лошади',
    j.name AS 'Имя жокея',
    res.place AS 'Место',
    res.finish_time AS 'Время заезда'
 FROM results res
 JOIN races r ON res.race_id = r.id
 JOIN competitions c ON r.competition_id = c.id
 JOIN horses h ON res.horse_id = h.id
 JOIN jockeys j ON res.jockey_id = j.id
 ORDER BY c.date, r.race_number, res.place;
Здача про оценки на ключи и удаление
 CREATE TABLE students(
  name_PK varchar(255) PRIMARY KEY, 
  age int);

 insert into students (name_PK,age) values 
 ('masha',18),
 ('galia',19),
 ('sveta',20);

 CREATE TABLE grades(
 name_FK varchar(255), 
 credits int, 
 CONSTRAINT fk_name FOREIGN KEY (name_FK) 
    REFERENCES students(name_PK) ON DELETE CASCADE);

 insert into grades (name_FK,credits) values 
 ('masha',3),
 ('sveta',4),
 ('galia',6);